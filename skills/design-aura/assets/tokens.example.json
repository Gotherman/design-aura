  "typography": {
    "font-display": "'Geist', 'Inter', system-ui, -apple-system, sans-serif",
    "font-ui": "'Geist', 'Inter', system-ui, -apple-system, sans-serif",
    "font-mono": "'Geist Mono', 'JetBrains Mono', ui-monospace, monospace",
    "text-base": "15px",
    "measure-body": "68ch",
    "tracking-display": "-0.025em"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "control-sm": "6px",
    "control-md": "8px",
    "card-sm": "12px",
    "card-md": "16px",
    "card-lg": "20px",
    "pill": "999px"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-enter": "220ms",
    "duration-exit": "140ms",
    "page-desktop": "200ms",
    "page-ios": "350ms",
    "page-android": "250ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "press-scale": "0.97"
  }
}
