{
  "meta": {
    "brand": "Meridiano Frota & Operações",
    "version": "1.0.0",
    "defaultTheme": "dark"
  },
  "primitive": {
    "navy-950": "#081018",
    "navy-900": "#0F1A26",
    "navy-850": "#162536",
    "navy-800": "#1D3046",
    "navy-750": "#253B55",
    "sand-300": "#D9D6CE",
    "sand-200": "#E6E3DC",
    "white-paper": "#FFFFFF",
    "slate-950": "#101822",
    "slate-700": "#435163",
    "slate-300": "#CBD5E1",
    "slate-200": "#E2E8F0",
    "copper-600": "#C2410C",
    "copper-500": "#EA580C",
    "copper-400": "#FB923C",
    "sky-500": "#3B82F6",
    "sky-700": "#1D4ED8",
    "emerald-700": "#047857",
    "emerald-400": "#34D399",
    "amber-700": "#B45309",
    "amber-400": "#FBBF24",
    "crimson-700": "#B91C1C",
    "crimson-400": "#F87171"
  },
  "semantic": {
    "light": {
      "surface-z0": "{primitive.sand-300}",
      "surface-z1": "{primitive.sand-200}",
      "surface-z2": "{primitive.white-paper}",
      "surface-z3": "#FAF8F5",
      "surface-z4": "{primitive.white-paper}",
      "text-strong": "{primitive.slate-950}",
      "text-body": "#243040",
      "text-muted": "{primitive.slate-700}",
      "border-subtle": "#C2C7CE",
      "border-strong": "#8A96A6",
      "primary": "#162A3E",
      "on-primary": "#F8FAFC",
      "accent": "{primitive.copper-600}",
      "on-accent": "#FFFFFF",
      "success": "{primitive.emerald-700}",
      "on-success": "#FFFFFF",
      "warning": "{primitive.amber-700}",
      "on-warning": "#FFFFFF",
      "danger": "{primitive.crimson-700}",
      "on-danger": "#FFFFFF",
      "info": "{primitive.sky-700}",
      "on-info": "#FFFFFF"
    },
    "dark": {
      "surface-z0": "{primitive.navy-950}",
      "surface-z1": "{primitive.navy-900}",
      "surface-z2": "{primitive.navy-850}",
      "surface-z3": "{primitive.navy-800}",
      "surface-z4": "{primitive.navy-750}",
      "text-strong": "#F3F6FA",
      "text-body": "#D3DEEC",
      "text-muted": "#A8B9CC",
      "border-subtle": "#293D54",
      "border-strong": "#446282",
      "primary": "#7CC0FA",
      "on-primary": "#081018",
      "accent": "#FF9466",
      "on-accent": "#081018",
      "success": "{primitive.emerald-400}",
      "on-success": "#071510",
      "warning": "{primitive.amber-400}",
      "on-warning": "#161005",
      "danger": "#FDA4AF",
      "on-danger": "#190808",
      "info": "#7CC0FA",
      "on-info": "#081018"
    }
  },
  "typography": {
    "font-display": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
    "font-ui": "'Instrument Sans', system-ui, -apple-system, sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, monospace",
    "text-base": "15px",
    "measure-body": "68ch",
    "tracking-display": "-0.025em"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "control-sm": "8px",
    "card-sm": "12px",
    "card-md": "16px",
    "card-lg": "20px",
    "pill": "999px"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-enter": "220ms",
    "duration-exit": "140ms",
    "page-desktop": "200ms",
    "page-ios": "350ms",
    "page-android": "250ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "press-scale": "0.97"
  }
}
