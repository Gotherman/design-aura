{
  "meta": {
    "brand": "Meridiano Frota & Operações",
    "version": "2.2.1",
    "defaultTheme": "dark"
  },
  "primitive": {
    "navy-950": "#081018",
    "navy-900": "#0F1A26",
    "navy-850": "#162536",
    "navy-800": "#1D3046",
    "navy-750": "#253B55",
    "sand-300": "#D9D6CE",
    "sand-200": "#E6E3DC",
    "white-paper": "#FFFFFF",
    "slate-950": "#101822",
    "slate-700": "#435163",
    "slate-300": "#CBD5E1",
    "slate-200": "#E2E8F0",
    "copper-600": "#C2410C",
    "copper-500": "#EA580C",
    "copper-400": "#FB923C",
    "sky-500": "#3B82F6",
    "sky-700": "#1D4ED8",
    "emerald-700": "#047857",
    "emerald-400": "#34D399",
    "amber-700": "#B45309",
    "amber-400": "#FBBF24",
    "crimson-700": "#B91C1C",
    "crimson-400": "#F87171",
    "obsidian-950": "#080C12",
    "obsidian-900": "#0E131D",
    "obsidian-850": "#141C29",
    "obsidian-800": "#1B2637",
    "obsidian-750": "#233046",
    "porcelain-300": "#DCE3EC",
    "porcelain-200": "#E6ECF3",
    "porcelain-100": "#F3F6FA",
    "teal-600": "#0D9488",
    "teal-400": "#22C3B8",
    "indigo-600": "#4F46E5",
    "indigo-400": "#818CF8",
    "rose-600": "#E11D48",
    "rose-400": "#F472B6"
  },
  "semantic": {
    "light": {
      "surface-z0": "#CFDCEB",
      "surface-z1": "#E1EAF4",
      "surface-z2": "{primitive.white-paper}",
      "surface-z3": "#EDF3FA",
      "surface-z4": "{primitive.white-paper}",
      "surface-brand-dark": "#0E294B",
      "surface-brand-dark-2": "#163E70",
      "on-brand-dark": "#F8FAFC",
      "surface-tint-soft": "#E6F0FD",
      "border-tint": "#B5CEF0",
      "text-strong": "{primitive.slate-950}",
      "text-body": "#1E2D40",
      "text-muted": "{primitive.slate-700}",
      "border-subtle": "#B0C2D9",
      "border-strong": "#728AA8",
      "primary": "#14427A",
      "on-primary": "#F8FAFC",
      "accent": "{primitive.copper-600}",
      "on-accent": "#FFFFFF",
      "success": "{primitive.emerald-700}",
      "on-success": "#FFFFFF",
      "warning": "{primitive.amber-700}",
      "on-warning": "#FFFFFF",
      "danger": "{primitive.crimson-700}",
      "on-danger": "#FFFFFF",
      "info": "{primitive.sky-700}",
      "on-info": "#FFFFFF",
      "chart-1": "{primitive.sky-700}",
      "chart-2": "{primitive.teal-600}",
      "chart-3": "{primitive.indigo-600}",
      "chart-4": "{primitive.copper-600}",
      "chart-5": "{primitive.emerald-700}",
      "chart-6": "{primitive.rose-600}"
    },
    "dark": {
      "surface-z0": "{primitive.obsidian-950}",
      "surface-z1": "{primitive.obsidian-900}",
      "surface-z2": "{primitive.obsidian-850}",
      "surface-z3": "{primitive.obsidian-800}",
      "surface-z4": "{primitive.obsidian-750}",
      "text-strong": "#F3F6FB",
      "text-body": "#D5DFED",
      "text-muted": "#A8B7CC",
      "border-subtle": "#263347",
      "border-strong": "#3E5270",
      "primary": "#6EB5FF",
      "on-primary": "#080C12",
      "accent": "#FF945E",
      "on-accent": "#080C12",
      "success": "{primitive.emerald-400}",
      "on-success": "#071510",
      "warning": "{primitive.amber-400}",
      "on-warning": "#161005",
      "danger": "#FDA4AF",
      "on-danger": "#190808",
      "info": "#6EB5FF",
      "on-info": "#080C12",
      "chart-1": "#4C9AFF",
      "chart-2": "{primitive.teal-400}",
      "chart-3": "{primitive.indigo-400}",
      "chart-4": "#FF8B4D",
      "chart-5": "{primitive.emerald-400}",
      "chart-6": "{primitive.rose-400}"
    }
  },
  "typography": {
    "font-display": "'Geist', 'Inter', system-ui, -apple-system, sans-serif",
    "font-ui": "'Geist', 'Inter', system-ui, -apple-system, sans-serif",
    "font-mono": "'Geist Mono', 'JetBrains Mono', ui-monospace, monospace",
    "text-base": "15px",
    "measure-body": "68ch",
    "tracking-display": "-0.025em"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "control-sm": "8px",
    "card-sm": "12px",
    "card-md": "16px",
    "card-lg": "20px",
    "pill": "999px"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-enter": "220ms",
    "duration-exit": "140ms",
    "page-desktop": "200ms",
    "page-ios": "350ms",
    "page-android": "250ms",
    "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "press-scale": "0.97"
  }
}
